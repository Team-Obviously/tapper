{
  "name": "contact-verification-contract",
  "version": "1.0.0",
  "description": "Self Protocol contact verification contract with userDefinedData integration",
  "main": "index.js",
  "scripts": {
    "build": "forge build",
    "test": "forge test",
    "test:verbose": "forge test -vvv",
    "deploy:sepolia": "forge script Deploy.s.sol --rpc-url sepolia --broadcast --verify",
    "deploy:celo-sepolia": "forge script Deploy.s.sol --rpc-url celo-sepolia --broadcast --verify",
    "deploy:local": "forge script Deploy.s.sol --rpc-url http://localhost:8545 --broadcast",
    "install:deps": "forge install selfxyz/self-contracts",
    "update:deps": "forge update",
    "clean": "forge clean",
    "size": "forge build --sizes"
  },
  "keywords": [
    "self-protocol",
    "zero-knowledge",
    "contact-verification",
    "nfc",
    "ethereum",
    "solidity"
  ],
  "author": "Tapper Team",
  "license": "MIT",
  "devDependencies": {
    "forge-std": "^1.7.0"
  },
  "dependencies": {
    "@selfxyz/contracts": "latest"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/tapper"
  },
  "bugs": {
    "url": "https://github.com/your-org/tapper/issues"
  },
  "homepage": "https://github.com/your-org/tapper#readme"
}
