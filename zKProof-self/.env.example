# Environment variables for ContactVerification contract deployment

# Private key for deployment (without 0x prefix)
PRIVATE_KEY=0xyour-private-key

# Self Protocol Hub V2 addresses
# Sepolia: 0x1234567890123456789012345678901234567890
# Celo Sepolia: 0x1234567890123456789012345678901234567890
HUB_ADDRESS=0x16ECBA51e18a4a7e61fdC417f0d47AFEeDfbed74

# Scope seed for this contract (should be unique per application)
SCOPE_SEED=contact-verification-tapper

# API Keys for verification
INFURA_API_KEY=your_infura_api_key
ETHERSCAN_API_KEY=your_etherscan_api_key
CELOSCAN_API_KEY=your_celoscan_api_key

# Network configuration
NETWORK=sepolia
